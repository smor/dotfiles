#!/bin/sh
# Installs the node/python versions in ~/.config/mise/config.toml.
# Runs after the Brewfile (which installs mise), and when the config changes.
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -e
PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
if command -v mise >/dev/null 2>&1; then
  mise install --yes
else
  echo "mise not found; skipping 'mise install'" >&2
fi
