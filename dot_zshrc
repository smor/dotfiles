#!/bin/zsh

# mise: node/python versions (replaces nvm + pyenv). Reads .nvmrc and
# .python-version (see ~/.config/mise/config.toml) and switches on cd.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"

  # Announce version changes on cd, e.g. "node 24.21.0 → 22.15.0" (not at startup).
  # Reads versions from mise's entries in $PATH, so it costs no subprocess.
  typeset -gA _MISE_SEEN
  _mise_announce() {
    local tool v p msg=()
    for tool in node python; do
      p=${${(M)path:#*/mise/installs/$tool/*}[1]}
      v=; [[ -n $p ]] && v=${${p:h:A}:t}   # .../installs/node/24/bin -> 24.21.0
      if (( ${+_MISE_SEEN[$tool]} )) && [[ $v != ${_MISE_SEEN[$tool]} ]]; then
        msg+="$tool ${_MISE_SEEN[$tool]:-system} → ${v:-system}"
      fi
      _MISE_SEEN[$tool]=$v
    done
    (( $#msg )) && print -P "%F{8}${(j:, :)msg}%f"
  }
  autoload -U add-zsh-hook && add-zsh-hook precmd _mise_announce
fi

# Plugins: antidote (cloned by chezmoi into ~/.antidote), list in ~/.zsh_plugins.txt
is-linux() { [[ $OSTYPE == linux* ]] }   # used by `conditional:` in the plugin list
DISABLE_AUTO_TITLE=true                  # tab titles are set below, not by oh-my-zsh
if [[ -f ~/.antidote/antidote.zsh ]]; then
  source ~/.antidote/antidote.zsh
  antidote load
fi

# fzf: Ctrl-R fuzzy history (respects per-directory history), Ctrl-T insert path,
# Alt-C cd into a subdirectory. Needs fzf >= 0.48.
if (( $+commands[fzf] )) && [[ -z $ZSH_EXECUTION_STRING ]]; then  # skip for `zsh -c`
  source <(fzf --zsh)
fi

# Tab titles: "project" at the prompt, "project · command" while it runs,
# prefixed with the host over ssh. Project = git repo name, else the folder name.
# (Ghostty's own title feature is turned off in its config so they don't fight.)
autoload -U add-zsh-hook
_tab_title_project() {
  local d=$PWD
  while [[ $d != / && ! -e $d/.git ]]; do d=${d:h}; done
  if [[ -e $d/.git && $d != $HOME ]]; then
    _TAB_TITLE_PROJECT=${d:t}
  elif [[ $PWD == $HOME ]]; then
    _TAB_TITLE_PROJECT='~'
  else
    _TAB_TITLE_PROJECT=${PWD:t}
  fi
  [[ -n $SSH_CONNECTION ]] && _TAB_TITLE_PROJECT="${HOST%%.*}: $_TAB_TITLE_PROJECT"
}
_tab_title_set() {
  [[ $TERM == dumb ]] && return
  print -rn -- $'\e]2;'"${1//[[:cntrl:]]/}"$'\a'
}
_tab_title_precmd() { _tab_title_set "$_TAB_TITLE_PROJECT" }
_tab_title_preexec() {
  local cmd=${${1//$'\n'/ }## #}
  (( ${#cmd} > 40 )) && cmd="${cmd[1,39]}…"
  _tab_title_set "$_TAB_TITLE_PROJECT · $cmd"
}
add-zsh-hook chpwd _tab_title_project
add-zsh-hook precmd _tab_title_precmd
add-zsh-hook preexec _tab_title_preexec
_tab_title_project

# zoxide: smarter cd. `z foo` (or `j foo`) jumps to the best match for "foo",
# `zi` (or `ji`) picks interactively with fzf; `z foo<Space><Tab>` lists matches.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
  alias j=z ji=zi
fi

#== History ================
unsetopt share_history         # keep each session's history separate...
setopt inc_append_history      # ...but write lines immediately; per-directory-history
                               # never writes its per-dir files without this

#== Sound ==================
setopt NO_HIST_BEEP            # Don't beep on failed history lookups
setopt NO_BEEP                 # Do not beep on line editor errors
setopt NO_LIST_BEEP            # Prevent beeping on ambiguous completion

# Load local zshrc file if it exists
if [ -f ~/.zshrc_local ]; then
  source ~/.zshrc_local
fi
