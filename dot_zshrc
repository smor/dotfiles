#!/bin/zsh

# NVM: lazy-load (eager loading + auto-use cost ~2s per shell).
# Auto-switching on .nvmrc is handled by _nvm_auto_use_lazy below.
export NVM_DIR="$HOME/.nvm"
NVM_LAZY_LOAD=true

# Plugins: antidote (cloned by chezmoi into ~/.antidote), list in ~/.zsh_plugins.txt
is-linux() { [[ $OSTYPE == linux* ]] }   # used by `conditional:` in the plugin list
if [[ -f ~/.antidote/antidote.zsh ]]; then
  source ~/.antidote/antidote.zsh
  antidote load
fi

# Default node on PATH immediately, so node scripts work before nvm is loaded
_nvm_default_bin=( $NVM_DIR/versions/node/v$(<$NVM_DIR/alias/default 2>/dev/null)*(NnOn[1]) )
[[ -n $_nvm_default_bin ]] && export PATH="$_nvm_default_bin/bin:$PATH"
unset _nvm_default_bin

# Auto-use .nvmrc; only loads nvm when a project actually has one
autoload -U add-zsh-hook
_nvm_auto_use_lazy() {
  local d=$PWD
  while [[ $d != / && ! -f $d/.nvmrc ]]; do d=${d:h}; done
  if [[ -f $d/.nvmrc ]]; then
    nvm use 2>/dev/null || nvm install
    _NVM_AUTO_SWITCHED=1
  elif [[ -n $_NVM_AUTO_SWITCHED ]]; then
    nvm use default
    unset _NVM_AUTO_SWITCHED
  fi
}
add-zsh-hook chpwd _nvm_auto_use_lazy
_nvm_auto_use_lazy

# pyenv: shims are on PATH (see .zprofile); load the full shell integration on first use
pyenv() {
  unfunction pyenv
  eval "$(command pyenv init - --no-rehash zsh)"
  pyenv "$@"
}

#== History ================
unsetopt share_history         # keep each session's history separate...
setopt inc_append_history      # ...but write lines immediately; per-directory-history
                               # never writes its per-dir files without this

#== Sound ==================
setopt NO_HIST_BEEP            # Don't beep on failed history lookups
setopt NO_BEEP                 # Do not beep on line editor errors
setopt NO_LIST_BEEP            # Prevent beeping on ambiguous completion

# Load local zshrc file if it exists
if [ -f ~/.zshrc_local ]; then
  source ~/.zshrc_local
fi
