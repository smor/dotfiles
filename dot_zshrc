#!/bin/zsh

# NVM: lazy-load (eager loading + auto-use cost ~2s per shell).
# Auto-switching on .nvmrc is handled by _nvm_auto_use_lazy below.
export NVM_DIR="$HOME/.nvm"
NVM_LAZY_LOAD=true

# Antigen
ANTIGEN=$HOME/.antigen/
[ -f $ANTIGEN/antigen.zsh ] || git clone\
  https://github.com/zsh-users/antigen.git $ANTIGEN
if [[ -f $ANTIGEN/antigen.zsh ]]; then
  source $ANTIGEN/antigen.zsh
  antigen use oh-my-zsh

  if [[ "$OSTYPE" == linux* ]]; then
    antigen bundle systemd
    antigen bundle sudo        # [Esc] [Esc] prefixes the command with sudo
  fi

  # oh-my-zsh plugins
  antigen bundle git
  antigen bundle dircycle      # Ctrl+Shift+Left/Right cycles the directory stack
  antigen bundle history
  antigen bundle docker
  antigen bundle npm
  antigen bundle node
  antigen bundle pip
  antigen bundle python
  antigen bundle dirpersist    # persist the directory stack across sessions
  antigen bundle autojump      # j <dir>; needs `brew install autojump`
  antigen bundle command-not-found
  antigen bundle common-aliases
  # Per directory history (Ctrl-G toggles global/directory history).
  # Needs inc_append_history, see History options below.
  antigen bundle per-directory-history

  # Third-party plugins
  antigen bundle zsh-users/zsh-completions src
  antigen bundle zsh-users/zsh-autosuggestions
  antigen bundle akoenig/npm-run.plugin.zsh
  antigen bundle bckim92/zsh-autoswitch-conda
  antigen bundle leophys/zsh-plugin-fzf-finder  # Alt-e: find a file and edit it
  antigen bundle lukechilds/zsh-nvm

  antigen theme robbyrussell
  antigen apply
fi

# Default node on PATH immediately, so node scripts work before nvm is loaded
_nvm_default_bin=( $NVM_DIR/versions/node/v$(<$NVM_DIR/alias/default 2>/dev/null)*(NnOn[1]) )
[[ -n $_nvm_default_bin ]] && export PATH="$_nvm_default_bin/bin:$PATH"
unset _nvm_default_bin

# Auto-use .nvmrc; only loads nvm when a project actually has one
autoload -U add-zsh-hook
_nvm_auto_use_lazy() {
  local d=$PWD
  while [[ $d != / && ! -f $d/.nvmrc ]]; do d=${d:h}; done
  if [[ -f $d/.nvmrc ]]; then
    nvm use 2>/dev/null || nvm install
    _NVM_AUTO_SWITCHED=1
  elif [[ -n $_NVM_AUTO_SWITCHED ]]; then
    nvm use default
    unset _NVM_AUTO_SWITCHED
  fi
}
add-zsh-hook chpwd _nvm_auto_use_lazy
_nvm_auto_use_lazy

# pyenv: shims are on PATH (see .zprofile); load the full shell integration on first use
pyenv() {
  unfunction pyenv
  eval "$(command pyenv init - --no-rehash zsh)"
  pyenv "$@"
}

#== History ================
unsetopt share_history         # keep each session's history separate...
setopt inc_append_history      # ...but write lines immediately; per-directory-history
                               # never writes its per-dir files without this

#== Sound ==================
setopt NO_HIST_BEEP            # Don't beep on failed history lookups
setopt NO_BEEP                 # Do not beep on line editor errors
setopt NO_LIST_BEEP            # Prevent beeping on ambiguous completion

# Load local zshrc file if it exists
if [ -f ~/.zshrc_local ]; then
  source ~/.zshrc_local
fi
