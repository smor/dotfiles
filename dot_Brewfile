# Homebrew packages, installed by `brew bundle --global` (chezmoi runs it when
# this file changes; see run_onchange_after_brew-bundle.sh.tmpl).
#   Add a package:     add a line here, then `chezmoi apply`
#   Check what's missing:            brew bundle check --global
#   Installed but not listed here:   brew bundle cleanup --global   (dry run)
# Apps installed by hand (Ghostty, Docker, Cursor, VS Code, ...) aren't listed:
# brew would try to reinstall them. To hand one over to brew:
#   brew install --cask --adopt <name>   then add `cask "<name>"` here.

# Shell & terminal
brew "zoxide"          # smarter cd (z / zi)
brew "fzf"             # fuzzy finder (Ctrl-R, Ctrl-T, Alt-C)
brew "ripgrep"         # fast grep
brew "bat"             # cat with syntax highlighting
brew "jq"              # JSON processor
brew "mise"            # node/python versions
brew "starship"        # prompt

# Git
brew "git"
brew "gh"              # GitHub CLI (also git's credential helper)
brew "diff-so-fancy"   # nicer git diffs
brew "git-filter-repo" # rewrite git history

# Languages & runtimes
brew "uv"              # Python packages and venvs
brew "openjdk"
brew "openjdk@21"
brew "powershell"

# Dev & infra tools
brew "cloudflared"     # Cloudflare Tunnel
brew "dvc"             # data version control
brew "cmake"
cask "azure-cli"

# Documents, media, PDF
brew "typst"           # typesetting
brew "ffmpeg"
brew "ghostscript"
brew "poppler"         # PDF tools (pdftotext, ...)
brew "verapdf"         # PDF/A validation
brew "librsvg"         # SVG rendering (rsvg-convert)

# Build tools and libraries
brew "automake"
brew "libtool"
brew "gettext"
brew "texinfo"
brew "libmagic"
brew "mono-libgdiplus"
