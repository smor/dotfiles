# Apps installed by hand on this Mac that Homebrew couldn't take over (version
# mismatch, or needs sudo). Installed by brew only where the app is missing,
# e.g. on a new Mac. (A Brewfile is Ruby, hence the `unless`.)
def app?(name)
  File.exist?("/Applications/#{name}.app")
end
cask "google-chrome"    unless app?("Google Chrome")
cask "docker-desktop"   unless app?("Docker")
cask "telegram-desktop" unless app?("Telegram")
cask "blender"          unless app?("Blender")
cask "calibre"          unless app?("calibre")
cask "freecad"          unless app?("FreeCAD")
