# Homebrew: put it ahead of /usr/bin so brew tools win over Apple's (jq, git, ...)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [ -x /usr/local/bin/brew ]; then        # Intel Mac
  eval "$(/usr/local/bin/brew shellenv zsh)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi

# mise shims: right node/python for non-interactive shells (editors, scripts).
# Interactive shells use `mise activate` from .zshrc instead.
export PATH="$HOME/.local/share/mise/shims:$PATH"

# chezmoi is installed in ~/bin
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

export RIPGREP_CONFIG_PATH=~/.ripgreprc
